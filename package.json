{
	"name": "simple-auth",
	"private": true,
	"version": "0.1.2",
	"type": "module",
	"packageManager": "bun@1.3.12",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:lib": "bun run --cwd simple-auth-lib build",
		"preview": "bun run build && wrangler dev --config wrangler.jsonc --ip 0.0.0.0 --port 5100",
		"format": "prettier --write .",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"test": "bun run test:unit && bun run test:e2e",
		"db:generate": "drizzle-kit generate --config drizzle.config.ts",
		"db:migrate": "wrangler d1 migrations apply simple-auth-web --local --config wrangler.jsonc",
		"db:migrate:remote": "wrangler d1 migrations apply simple-auth-web --remote --env production --config wrangler.jsonc",
		"cf-typegen": "wrangler types --config wrangler.jsonc ./src/cf-bindings.d.ts --env-interface CfEnv"
	},
	"dependencies": {
		"@simplewebauthn/browser": "^13.1.2",
		"@simplewebauthn/server": "^13.1.2",
		"@znut/simple-auth-lib": "file:./simple-auth-lib",
		"drizzle-orm": "^0.45.2"
	},
	"devDependencies": {
		"@eslint/js": "^9.38.0",
		"@playwright/test": "^1.56.1",
		"@sveltejs/adapter-cloudflare": "^7.2.3",
		"@sveltejs/kit": "^2.37.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.14",
		"@types/node": "^22.18.6",
		"daisyui": "^5.1.7",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9.38.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"globals": "^16.4.0",
		"playwright": "^1.56.1",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.1",
		"svelte": "^5.38.7",
		"svelte-check": "^4.3.3",
		"tailwindcss": "^4.1.14",
		"tsup": "^8.5.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.1",
		"vite": "^7.1.10",
		"vitest": "^4.0.5",
		"wrangler": "^4.49.0"
	}
}
