{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "simple-auth",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-04-21",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS",
	},
	"observability": {
		"enabled": true,
	},
	"vars": {
		"UNSAFE_DEV_MODE": "true",
	},
	/* non-inherited */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "simple-auth-web",
			"database_id": "00000000-0000-0000-0000-000000000010",
			"preview_database_id": "00000000-0000-0000-0000-000000000011",
			"migrations_dir": "db/migrations",
		},
	],
	"env": {
		"production": {
			"name": "simple-auth",
			"vars": {
				"RETURN_URL_ALLOWLIST": "https://dont.forget.to.changeme/auth/callback",
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "simple-auth-web",
					"database_id": "00000000-0000-0000-0000-000000000010",
					"migrations_dir": "db/migrations",
				},
			],
		},
	},
}
