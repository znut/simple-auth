{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "simple-auth",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-04-21",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS",
	},
	"vars": {
		"SESSION_COOKIE_DOMAIN": ".ex.localhost",
		"SESSION_SECRET": "dev-session-secret",
	},
	"observability": {
		"enabled": true,
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "simple-auth-web",
			"database_id": "00000000-0000-0000-0000-000000000010",
			"preview_database_id": "00000000-0000-0000-0000-000000000011",
			"migrations_dir": "db/migrations",
		},
	],
	"env": {
		"production": {
			"workers_dev": false,
			"vars": {
				"SESSION_COOKIE_DOMAIN": ".example.com",
				"SESSION_SECRET": "remove-this-and-put-in-secret-store",
			},
			"routes": [
				{
					"pattern": "auth.example.com",
					"custom_domain": true,
				},
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "simple-auth-web",
					"database_id": "00000000-0000-0000-0000-000000000010",
					"preview_database_id": "00000000-0000-0000-0000-000000000011",
					"migrations_dir": "db/migrations",
				},
			],
		},
	},
}
